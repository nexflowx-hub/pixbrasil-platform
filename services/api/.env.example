# PiXBrasil API runtime configuration.
# Never commit real database passwords, Redis credentials or provider secrets.

PORT=8080
RUNTIME_STRICT=false

# Atlas Financial Core Supabase connection string on the VPS.
# Include sslmode=require in the production URL.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Dedicated PiXBrasil Redis. In Docker Compose this resolves by service name.
REDIS_URL=redis://pixbrasil-redis:6379
