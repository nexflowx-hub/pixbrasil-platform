{
  "name": "PiXBrasil Terminal",
  "short_name": "PiX Terminal",
  "description": "Terminal móvel para cobranças PIX presenciais.",
  "id": "/terminal",
  "start_url": "/terminal?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#031511",
